     </StackPanel>
     <StackPanel Grid.Row="1">
      <TextBlock Text="WORKSPACE" FontSize="9" Foreground="#75829D" FontWeight="Bold" Margin="6,0,0,11" FontFamily="Segoe UI"/>
      <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="Selected" Click="NavDashboard_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 3,11 L 12,3 L 21,11 M 5,9.5 V 21 H 19 V 9.5 M 9,21 V 14 H 15 V 21" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" Width="19" Height="19" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="داشبورد" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Button>
      <Button x:Name="NavDns" Style="{StaticResource NavButton}" Click="NavDns_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Path Data="M 12,2 C 12,2 5,10 5,14 A 7,7 0 0 0 19,14 C 19,10 12,2 12,2 Z M 9,15 C 9,17 10,18 12,18" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Width="19" Height="19" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="DNS Studio" FontSize="12" VerticalAlignment="Center"/></Grid></Button>
