      <StackPanel FlowDirection="RightToLeft">
       <Border CornerRadius="20" Padding="22" Background="{StaticResource HeroGradient}" BorderBrush="#3D4F70" BorderThickness="1" Margin="0,0,0,17">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MIXO6 ID  /  PLAYER PROFILE" Style="{StaticResource EyebrowText}" FontFamily="Segoe UI"/><TextBlock Text="حساب تو، فضای خودت." FontSize="25" FontWeight="Bold" Margin="0,7,0,5"/><TextBlock Text="اول حساب بساز، ایمیل را تأیید کن و بعد وارد شو. نشست ورود به‌صورت رمزگذاری‌شده برای همین کاربر ویندوز نگهداری می‌شود." Foreground="#C2CDE0" FontSize="11" TextWrapping="Wrap" MaxWidth="700"/></StackPanel><Border Grid.Column="1" Width="72" Height="72" CornerRadius="22" Background="{StaticResource AccentGradient}" Padding="15" VerticalAlignment="Center"><TextBlock Text="◈" FontSize="34" Foreground="#09151D" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid>
        <Border Background="#11182A" BorderBrush="#34435E" BorderThickness="1" CornerRadius="11" Padding="12,10" Margin="0,16,0,0"><TextBlock x:Name="AuthStateText" Text="وارد نشده‌ای" Foreground="#E7C781" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/></Border>
       </Border>
       <TabControl x:Name="AuthTabs" Style="{StaticResource GlassTabs}">
        <TabItem Header="۱ · ساخت حساب">
         <Border Style="{StaticResource CardBorder}" Padding="23">
          <StackPanel MaxWidth="650" HorizontalAlignment="Center">
           <TextBlock Text="به MIXO6 خوش آمدی" FontSize="21" FontWeight="Bold" Margin="0,0,0,5"/>
           <TextBlock Text="اطلاعاتت را در سه فیلد وارد کن؛ بعد از ثبت‌نام به مرحله‌ی تأیید ایمیل می‌روی." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
           <TextBlock Text="نام کاربری" FontSize="11" Foreground="#B2BDD2" Margin="0,0,0,7"/><TextBox x:Name="RegisterUsernameBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" ToolTip="۳ تا ۲۰ حرف انگلیسی، عدد یا زیرخط" Margin="0,0,0,15"/>
           <TextBlock Text="آدرس ایمیل" FontSize="11" Foreground="#B2BDD2" Margin="0,0,0,7"/><TextBox x:Name="RegisterEmailBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Margin="0,0,0,15"/>
           <TextBlock Text="رمز عبور" FontSize="11" Foreground="#B2BDD2" Margin="0,0,0,7"/><PasswordBox x:Name="RegisterPasswordBox" Style="{StaticResource PasswordInput}" Margin="0,0,0,17"/>
           <Button Style="{StaticResource AccentButton}" Content="ساخت حساب و ارسال ایمیل تأیید" Click="Register_Click" HorizontalAlignment="Stretch"/>
           <TextBlock Text="رمز عبور در MIXO6 ذخیره نمی‌شود؛ اعتبارسنجی و ارسال ایمیل با سرویس ورود انجام می‌شود." Style="{StaticResource MutedText}" Margin="0,13,0,0"/>
          </StackPanel>
         </Border>
        </TabItem>
        <TabItem Header="۲ · تأیید ایمیل">
         <Border Style="{StaticResource CardBorder}" Padding="23">
          <StackPanel MaxWidth="650" HorizontalAlignment="Center">
           <TextBlock Text="ایمیل خودت را تأیید کن" FontSize="21" FontWeight="Bold" Margin="0,0,0,5"/>
           <TextBlock Text="کد یا توکن تأیید داخل پیام ایمیل را وارد کن. اگر پیام نرسید، پوشه‌ی Spam و وضعیت ایمیل سرویس را بررسی کن." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
           <TextBlock Text="ایمیل ثبت‌نام" FontSize="11" Foreground="#B2BDD2" Margin="0,0,0,7"/><TextBox x:Name="VerifyEmailBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Margin="0,0,0,15"/>
           <TextBlock Text="کد تأیید دریافتی" FontSize="11" Foreground="#B2BDD2" Margin="0,0,0,7"/><TextBox x:Name="VerifyCodeBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" MaxLength="20" Margin="0,0,0,17"/>
           <Button Style="{StaticResource AccentButton}" Content="تأیید ایمیل و ورود" Click="VerifyEmail_Click" HorizontalAlignment="Stretch"/>
           <Button Style="{StaticResource GhostButton}" Content="ارسال دوباره‌ی ایمیل تأیید" Click="ResendVerification_Click" Margin="0,9,0,0" HorizontalAlignment="Stretch"/>
          </StackPanel>
         </Border>
        </TabItem>
        <TabItem Header="ورود">
         <Border Style="{StaticResource CardBorder}" Padding="23">
          <StackPanel MaxWidth="650" HorizontalAlignment="Center">
           <TextBlock Text="ادامه‌ی بازی از همین‌جا" FontSize="21" FontWeight="Bold" Margin="0,0,0,5"/>
           <TextBlock Text="با ایمیل یا نام کاربری و رمز عبور وارد شو." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
           <TextBlock Text="ایمیل یا نام کاربری" FontSize="11" Foreground="#B2BDD2" Margin="0,0,0,7"/><TextBox x:Name="LoginIdentifierBox" ToolTip="email@example.com یا username" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Margin="0,0,0,15"/>
           <TextBlock Text="رمز عبور" FontSize="11" Foreground="#B2BDD2" Margin="0,0,0,7"/><PasswordBox x:Name="LoginPasswordBox" Style="{StaticResource PasswordInput}" Margin="0,0,0,17"/>
           <Button Style="{StaticResource AccentButton}" Content="ورود به حساب" Click="Login_Click" HorizontalAlignment="Stretch"/>
           <Button Style="{StaticResource GhostButton}" Content="خروج از حساب فعلی" Click="Logout_Click" HorizontalAlignment="Stretch" Margin="0,9,0,0"/>
          </StackPanel>
         </Border>
        </TabItem>
        <TabItem Header="پروفایل من">
         <Border Style="{StaticResource CardBorder}" Padding="23">
          <StackPanel MaxWidth="650" HorizontalAlignment="Center">
           <TextBlock Text="تنظیمات پروفایل بازی" FontSize="21" FontWeight="Bold" Margin="0,0,0,5"/>
           <TextBlock Text="آواتار و بازی اصلی در حساب تو ذخیره می‌شوند؛ اگر وارد نشده‌ای، تغییرات فقط محلی خواهند بود." Style="{StaticResource MutedText}" Margin="0,0,0,20"/>
           <TextBlock Text="آواتار" FontSize="11" Foreground="#B2BDD2" Margin="0,0,0,7"/><ComboBox x:Name="ProfileAvatarCombo" Style="{StaticResource DarkCombo}" MinHeight="42" Margin="0,0,0,15"><ComboBoxItem Content="◈  Neon Core" Tag="◈"/><ComboBoxItem Content="✦  Nova" Tag="✦"/><ComboBoxItem Content="⬡  Phantom" Tag="⬡"/><ComboBoxItem Content="◆  Apex" Tag="◆"/><ComboBoxItem Content="◉  Orbit" Tag="◉"/></ComboBox>
           <TextBlock Text="بازی اصلی" FontSize="11" Foreground="#B2BDD2" Margin="0,0,0,7"/><TextBox x:Name="ProfileMainGameBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Text="CS2" Margin="0,0,0,17"/>
           <Button Style="{StaticResource AccentButton}" Content="ذخیره‌ی پروفایل" Click="SaveProfile_Click" HorizontalAlignment="Stretch"/>
           <TextBlock x:Name="ProfileSaveStatusText" Text="تغییرات فقط پس از ذخیره ثبت می‌شوند." Foreground="#A0ADC4" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
          </StackPanel>
         </Border>
        </TabItem>
       </TabControl>
      </StackPanel>
     </ScrollViewer>

     <!-- SITES / ORIGIN HUB -->
     <ScrollViewer x:Name="SitesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel FlowDirection="RightToLeft">
       <Border CornerRadius="20" Padding="24" BorderBrush="#3C5B72" BorderThickness="1" Background="{StaticResource HeroGradient}" Margin="0,0,0,17"><StackPanel><TextBlock Text="ORIGIN HUB  /  YOUR LINKS" Style="{StaticResource EyebrowText}" FontFamily="Segoe UI"/><TextBlock Text="پرتال‌هایت، یک‌جا." FontSize="26" FontWeight="Bold" Margin="0,7,0,5"/><TextBlock Text="میانبرهای رسمی و موردعلاقه‌ی تو؛ با یک کلیک در مرورگر ویندوز باز می‌شوند." Style="{StaticResource MutedText}" Foreground="#C2CDE0"/></StackPanel></Border>
       <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0"><StackPanel><Border Width="57" Height="57" CornerRadius="17" Background="{StaticResource AccentGradient}" Padding="8" HorizontalAlignment="Left"><Image Source="pack://application:,,,/assets/mixo6-logo.png" Stretch="Uniform"/></Border><TextBlock Text="FARSI ORIGIN" FontSize="17" FontWeight="Bold" Margin="0,15,0,5" FontFamily="Segoe UI"/><TextBlock Text="فارسی‌ساز حرفه‌ای بازی‌های ویدیویی" Style="{StaticResource MutedText}" Margin="0,0,0,17"/><Button Style="{StaticResource AccentButton}" Content="بازکردن سایت  ↗" Click="OpenFarsiOrigin_Click" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="7,0,0,0"><StackPanel><Border Width="57" Height="57" CornerRadius="17" Background="#252B48" BorderBrush="#505C8A" BorderThickness="1" HorizontalAlignment="Left" Padding="10"><TextBlock Text="RTX" FontWeight="Bold" Foreground="#B5B3FF" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/></Border><TextBlock Text="RTX GAME" FontSize="17" FontWeight="Bold" Margin="0,15,0,5" FontFamily="Segoe UI"/><TextBlock Text="هاب ابزارها و سرویس‌های گیمینگ" Style="{StaticResource MutedText}" Margin="0,0,0,17"/><Button Style="{StaticResource AccentButton}" Content="بازکردن سایت  ↗" Click="OpenRtxGame_Click" HorizontalAlignment="Left"/></StackPanel></Border>
       </Grid>
       <Border Style="{StaticResource CardBorder}" Margin="0,0,0,17"><StackPanel><Border Width="57" Height="57" CornerRadius="17" Background="#1C3835" BorderBrush="#397E70" BorderThickness="1" HorizontalAlignment="Left" Padding="10"><TextBlock Text="V" FontWeight="Bold" Foreground="#7BE8D0" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI"/></Border><TextBlock Text="VIDOX TOOLBOX" FontSize="17" FontWeight="Bold" Margin="0,15,0,5" FontFamily="Segoe UI"/><TextBlock Text="جعبه‌ابزار آنلاین" Style="{StaticResource MutedText}" Margin="0,0,0,17"/><Button Style="{StaticResource AccentButton}" Content="بازکردن سایت  ↗" Click="OpenVidox_Click" HorizontalAlignment="Left"/></StackPanel></Border>
       <TextBlock Text="اگر لینکی باز نشد، دسترسی اینترنت یا محدودیت‌های شبکه را بررسی کن." Style="{StaticResource MutedText}" Margin="2,0,0,10"/>
      </StackPanel>
     </ScrollViewer>

     <!-- STORE -->
     <Grid x:Name="StorePanel" Visibility="Collapsed">
      <Border Style="{StaticResource CardBorder}" HorizontalAlignment="Center" VerticalAlignment="Center" Width="500" Padding="40">
       <StackPanel HorizontalAlignment="Center">
        <Border Width="86" Height="86" CornerRadius="27" Background="{StaticResource AccentGradient}" Padding="17"><TextBlock Text="✦" FontSize="43" FontWeight="Bold" Foreground="#0B1720" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <TextBlock Text="MIXO6 STORE" FontSize="11" FontWeight="Bold" Foreground="#8AE9D7" Margin="0,21,0,7" HorizontalAlignment="Center" FontFamily="Segoe UI"/>
        <TextBlock Text="فروشگاه در راه است" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
        <TextBlock Text="فضای فروشگاه برای محصولات و سرویس‌های گیمینگ رزرو شده است. پرداخت و عرضه‌ی محصول بعد از آماده‌شدن زیرساخت امن فعال می‌شود." TextAlignment="Center" Foreground="#A9B5CC" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,22"/>
        <Border BorderBrush="#42566B" Background="#17212E" BorderThickness="1" CornerRadius="18" Padding="15,8"><TextBlock Text="COMING SOON" Foreground="#8AE9D7" FontSize="10" FontWeight="Bold" FontFamily="Segoe UI"/></Border>
       </StackPanel>
      </Border>
     </Grid>

     <!-- SETTINGS -->
     <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel FlowDirection="RightToLeft">
       <Border CornerRadius="20" Padding="24" Background="{StaticResource HeroGradient}" BorderBrush="#3A556B" BorderThickness="1" Margin="0,0,0,17"><StackPanel><TextBlock Text="PREFERENCES  /  SYSTEM" Style="{StaticResource EyebrowText}" FontFamily="Segoe UI"/><TextBlock Text="فضای MIXO6 را تنظیم کن." FontSize="25" FontWeight="Bold" Margin="0,7,0,5"/><TextBlock Text="اطلاعات اتصال سرویس‌ها در رابط کاربری نمایش داده نمی‌شوند؛ وضعیت اتصال را بدون افشای کلیدها بررسی کن." Style="{StaticResource MutedText}" Foreground="#C2CDE0"/></StackPanel></Border>
       <Border Style="{StaticResource CardBorder}" Margin="0,0,0,17">
        <StackPanel><TextBlock Text="وضعیت سرویس‌های آنلاین" Style="{StaticResource CardTitle}"/><TextBlock Text="برای استفاده از حساب، پروفایل و لابی به اتصال اینترنت نیاز است." Style="{StaticResource MutedText}" Margin="0,0,0,13"/><Button Style="{StaticResource AccentButton}" Content="بررسی اتصال" Click="CheckServices_Click" HorizontalAlignment="Left"/><TextBlock x:Name="SettingsApiStatusText" Text="وضعیت اتصال هنوز بررسی نشده است." Foreground="#AAB7CF" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
       </Border>
       <Border Style="{StaticResource CardBorder}" Margin="0,0,0,17">
        <StackPanel><TextBlock Text="رفتار برنامه" Style="{StaticResource CardTitle}"/><TextBlock Text="ویجت شناور و شروع خودکار ویندوز را از این بخش مدیریت کن." Style="{StaticResource MutedText}" Margin="0,0,0,13"/><CheckBox x:Name="ShowWidgetCheck" Style="{StaticResource DarkCheck}" Content="نمایش ویجت شیشه‌ای CPU / GPU / FPS روی دسکتاپ"/><CheckBox x:Name="StartupCheck" Style="{StaticResource DarkCheck}" Content="اجرای خودکار همراه ورود به ویندوز"/><Button Style="{StaticResource GhostButton}" Content="ذخیره‌ی تنظیمات" Click="SaveAppPreferences_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/><TextBlock x:Name="SettingsPreferencesStatusText" Text="" Foreground="#AAB7CF" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/></StackPanel>
       </Border>
       <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="درباره‌ی MIXO6" Style="{StaticResource CardTitle}"/><TextBlock Text="نسخه 1.1.0 · Windows 10 / Windows 11 · x64" Foreground="#AAB6CE" FontSize="12" Margin="0,5,0,0"/><TextBlock Text="ساخت اختصاصی Origin Core · مدیریت DNS با اجازه‌ی ویندوز، وضعیت سخت‌افزار و ابزارهای رقابتی." Style="{StaticResource MutedText}" Margin="0,8,0,0"/></StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>

   <!-- Right navigation -->
