<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" x:Class="MIXO6.MainWindow" Title="MIXO6" Width="1510" Height="950" MinWidth="1180" MinHeight="760" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Background="Transparent" AllowsTransparency="True" FlowDirection="LeftToRight" Loaded="Window_Loaded" Closing="Window_Closing" FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="20" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Border Background="#090C16" BorderBrush="#46516F" BorderThickness="1" CornerRadius="20" ClipToBounds="True">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

   <!-- Custom title bar -->
   <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#0E1322" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="23,0,0,0">
     <Border Width="35" Height="35" CornerRadius="11" Background="{StaticResource AccentGradient}" Padding="5" Margin="0,0,11,0">
      <Image Source="pack://application:,,,/assets/mixo6-logo.png" Stretch="Uniform"/>
     </Border>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="MIXO6" FontSize="17" FontWeight="ExtraBold"/>
      <TextBlock Text="GAMING CONTROL CENTER" FontSize="10.5" Foreground="#8490AA" Margin="0,2,0,0" FontFamily="Segoe UI"/>
     </StackPanel>
     <Border Background="#192D34" BorderBrush="#2E615B" BorderThickness="1" CornerRadius="15" Padding="9,5" Margin="15,0,0,0" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#62E7C6" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="WINDOWS · x64" FontSize="11" Foreground="#9EEADB" FontFamily="Segoe UI"/></StackPanel>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
     <Button Width="37" Height="32" Click="Minimize_Click" Style="{StaticResource TitlebarButton}" ToolTip="کوچک‌کردن پنجره"><Path Data="M 0,0 L 12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
     <Button Width="37" Height="32" Click="Maximize_Click" Style="{StaticResource TitlebarButton}" ToolTip="بزرگ‌نمایی پنجره"><Path Data="M 0,0 H 12 V 12 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
     <Button Width="37" Height="32" Click="Close_Click" Style="{StaticResource TitlebarButton}" Foreground="#F09AAA" ToolTip="بستن برنامه"><Path Data="M 0,0 L 11,11 M 11,0 L 0,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
    </StackPanel>
   </Grid>

   <!-- Main content -->
   <Grid Grid.Row="1" Grid.Column="1" Background="#0B0F1C">
    <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Ellipse Grid.Row="0" Grid.RowSpan="2" Width="350" Height="350" Fill="#384B8DFF" Opacity="0.18" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,40,0" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="95"/></Ellipse.Effect></Ellipse><Ellipse Grid.Row="1" Width="320" Height="320" Fill="#5038D9B9" Opacity="0.12" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-90,0,0,30" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect></Ellipse><Grid Grid.Row="0" Margin="29,14,27,13" FlowDirection="RightToLeft">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
      <TextBlock x:Name="PageTitleText" Text="مرکز کنترل" FontSize="28" FontWeight="Bold"/>
      <TextBlock x:Name="PageSubtitleText" Text="سخت‌افزار، شبکه و بازی‌ها؛ همه در یک فضای یکپارچه" Foreground="#98A3BC" FontSize="13" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
      <Border Background="#141A2A" BorderBrush="#2B354D" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,7,0" MinWidth="91">
       <StackPanel><TextBlock Text="CPU TEMP" FontSize="10.5" Foreground="#8796B4" FontFamily="Segoe UI"/><TextBlock x:Name="TopCpuTempText" Text="--°C" FontSize="15" FontWeight="Bold" Foreground="#F6BD73" Margin="0,3,0,0"/></StackPanel>
      </Border>
      <Border Background="#141A2A" BorderBrush="#2B354D" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,7,0" MinWidth="91">
       <StackPanel><TextBlock Text="GPU TEMP" FontSize="10.5" Foreground="#8796B4" FontFamily="Segoe UI"/><TextBlock x:Name="TopGpuTempText" Text="--°C" FontSize="15" FontWeight="Bold" Foreground="#D89BFF" Margin="0,3,0,0"/></StackPanel>
      </Border>
      <Border Background="#141A2A" BorderBrush="#2B354D" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,7,0" MinWidth="84">
       <StackPanel><TextBlock Text="LIVE FPS" FontSize="10.5" Foreground="#8796B4" FontFamily="Segoe UI"/><TextBlock x:Name="TopFpsText" Text="--" FontSize="15" FontWeight="Bold" Foreground="#70E9D0" Margin="0,3,0,0"/></StackPanel>
      </Border>
      <Border Background="#151B2C" BorderBrush="#303A54" BorderThickness="1" CornerRadius="12" Padding="10,9" VerticalAlignment="Center" Margin="0,0,0,0">
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#E4B76B" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="BackendStatusText" Text="بررسی اتصال" FontSize="12" Foreground="#B9C4DC" VerticalAlignment="Center"/></StackPanel>
      </Border>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="25,0,25,24">
     <!-- DASHBOARD -->
     <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel FlowDirection="RightToLeft">
       <Border CornerRadius="22" Padding="25" BorderThickness="1" BorderBrush="#3C5E74" Background="{StaticResource HeroGradient}" Margin="0,0,0,17">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="132" Height="132" CornerRadius="28" Background="#202C49" BorderBrush="#4B577E" BorderThickness="1" Padding="17" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Image Source="pack://application:,,,/assets/mixo6-logo.png" Stretch="Uniform"/>
         </Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Text="YOUR SETUP. YOUR RULES." Style="{StaticResource EyebrowText}" FontFamily="Segoe UI"/>
          <TextBlock Text="همه‌چیز زیر کنترل توئه." FontSize="28" FontWeight="Bold" Margin="0,7,0,5"/>
          <TextBlock Text="سخت‌افزار را زنده زیر نظر بگیر، DNS را با تأیید ویندوز مدیریت کن و برای بازی بعدی حریف پیدا کن." Foreground="#C0CBE0" FontSize="13" TextWrapping="Wrap" MaxWidth="650"/>
          <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
           <Button Style="{StaticResource AccentButton}" Click="OpenDnsPage_Click" Content="مدیریت DNS  ›" Margin="0,0,8,0"/>
           <Button Style="{StaticResource GhostButton}" Click="OpenTournamentPage_Click" Content="پیدا کردن حریف" Margin="0,0,8,0"/>
           <Button Style="{StaticResource GhostButton}" Click="ShowWidget_Click" Content="ویجت شناور"/>
          </StackPanel>
         </StackPanel>
        </Grid>
       </Border>

       <Grid Margin="0,0,0,17">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="پردازنده" FontSize="14" FontWeight="Bold"/><TextBlock Text="CPU TEMPERATURE" FontSize="10.5" Foreground="#8D9AB5" FontFamily="Segoe UI" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="9" Background="#3A3025" Padding="8,5"><TextBlock Text="CPU" Foreground="#F5C481" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/></Border></Grid>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,9" VerticalAlignment="Bottom"><TextBlock x:Name="CpuTempText" Text="--°C" FontSize="36" FontWeight="Bold" Foreground="#F5C481"/><TextBlock x:Name="CpuTempCaption" Text="در انتظار سنسور" Foreground="#A6B0C7" FontSize="12" VerticalAlignment="Bottom" Margin="9,0,0,7"/></StackPanel>
          <ProgressBar x:Name="CpuTempBar" Style="{StaticResource AccentProgress}" Maximum="110" Value="0"/>
          <TextBlock x:Name="CpuSensorNameText" Text="سنسور CPU" FontSize="12" Foreground="#7F8CA5" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="کارت گرافیک" FontSize="14" FontWeight="Bold"/><TextBlock Text="GPU TEMPERATURE" FontSize="10.5" Foreground="#8D9AB5" FontFamily="Segoe UI" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="9" Background="#312641" Padding="8,5"><TextBlock Text="GPU" Foreground="#DBB0FF" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/></Border></Grid>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,9" VerticalAlignment="Bottom"><TextBlock x:Name="GpuTempText" Text="--°C" FontSize="36" FontWeight="Bold" Foreground="#D8A6FF"/><TextBlock x:Name="GpuTempCaption" Text="در انتظار سنسور" Foreground="#A6B0C7" FontSize="12" VerticalAlignment="Bottom" Margin="9,0,0,7"/></StackPanel>
          <ProgressBar x:Name="GpuTempBar" Style="{StaticResource AccentProgress}" Maximum="110" Value="0"/>
          <TextBlock x:Name="GpuSensorNameText" Text="سنسور GPU" FontSize="12" Foreground="#7F8CA5" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="7,0,0,0">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="نرخ فریم بازی" FontSize="14" FontWeight="Bold"/><TextBlock Text="LIVE PRESENT FPS" FontSize="10.5" Foreground="#8D9AB5" FontFamily="Segoe UI" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="9" Background="#1B3637" Padding="8,5"><TextBlock Text="FPS" Foreground="#77E8D2" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"/></Border></Grid>
          <StackPanel Orientation="Horizontal" Margin="0,17,0,6" VerticalAlignment="Bottom"><TextBlock x:Name="FpsText" Text="--" FontSize="36" FontWeight="Bold" Foreground="#77E8D2"/><TextBlock Text="FPS" FontSize="12" Foreground="#A6B0C7" VerticalAlignment="Bottom" Margin="8,0,0,7" FontFamily="Segoe UI"/></StackPanel>
          <TextBlock Text="برای عدد واقعی، بازی را باز کن و آن را از فهرست انتخاب کن." Style="{StaticResource MutedText}" Margin="0,0,0,11"/>
          <ComboBox x:Name="FpsTargetCombo" Style="{StaticResource DarkCombo}" MinHeight="46" ToolTip="بازی در حال اجرا را انتخاب کن"/>
          <WrapPanel Margin="0,9,0,0"><Button Style="{StaticResource GhostButton}" Content="بازخوانی بازی‌ها" Click="RefreshFpsTargets_Click" Margin="0,0,7,0" Padding="10,7"/><Button Style="{StaticResource AccentButton}" Content="شروع پایش FPS" Click="StartFpsMonitor_Click" Padding="12,7"/><Button Style="{StaticResource GhostButton}" Content="توقف" Click="StopFpsMonitor_Click" Margin="7,0,0,0" Padding="10,7"/></WrapPanel>
          <TextBlock x:Name="FpsStatusText" Text="پایش FPS هنوز فعال نیست." FontSize="12" Foreground="#8D9AB5" Margin="0,9,0,0" TextWrapping="Wrap"/>
          <CheckBox x:Name="FpsRunElevatedCheck" Style="{StaticResource DarkCheck}" Content="اندازه‌گیری با مجوز مدیر (UAC؛ با تأیید ویندوز)" ToolTip="برای خواندن فریم واقعی، PresentMon ممکن است به دسترسی مدیر نیاز داشته باشد؛ UAC فقط پس از زدن شروع پایش و تأیید تو باز می‌شود." Margin="0,8,0,0" IsChecked="True"/>
         </StackPanel>
        </Border>
       </Grid>

       <Grid Margin="0,0,0,17">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
         <StackPanel>
          <TextBlock Text="شبکه‌ی فعال" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="وضعیت واقعی کارت شبکه و DNS فعلی ویندوز" Style="{StaticResource MutedText}" Margin="0,0,0,13"/>
          <TextBlock x:Name="DashboardInterfaceText" Text="کارت شبکه شناسایی نشده" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock x:Name="DashboardDnsText" Text="DNS: —" FontSize="12" Foreground="#B8C4DC" TextWrapping="Wrap" Margin="0,8,0,15"/>
          <StackPanel Orientation="Horizontal"><Button Style="{StaticResource AccentButton}" Content="مدیریت DNS" Click="OpenDnsPage_Click" Margin="0,0,8,0"/><Button Style="{StaticResource GhostButton}" Content="پاک‌کردن کش DNS" Click="FlushDns_Click"/></StackPanel>
         </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,0,0">
         <StackPanel>
          <TextBlock Text="میانبرهای هوشمند" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="کارهای روزمره، بدون جست‌وجو در منوها." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Content="◉   تست Ping و ابزار شبکه" Click="OpenDnsPage_Click" Margin="0,0,0,8"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Content="◈   پیدا کردن حریف" Click="OpenTournamentPage_Click" Margin="0,0,0,8"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Content="⬡   سایت‌ها و ابزارهای Origin" Click="OpenSitesPage_Click"/>
         </StackPanel>
        </Border>
       </Grid>
       <Border Background="#111827" BorderBrush="#25344B" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#62E7C6" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="SensorStatusText" Text="سنسورها در حال راه‌اندازی هستند…" FontSize="12" Foreground="#A6B3CC" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource GhostButton}" Content="بازخوانی سنسورها" Click="RefreshSensors_Click" Padding="11,7" Margin="9,0,0,0" FontSize="12" ToolTip="خواندن دوبارهٔ دمای واقعی سنسورهای CPU و GPU"/><Button x:Name="ElevateSensorButton" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource GhostButton}" Content="خواندن سنسورها با مجوز مدیر" Click="RestartAsAdmin_Click" Padding="9,6" Margin="12,0,0,0" FontSize="10" ToolTip="فقط پس از تأیید تو، پنجره‌ی UAC ویندوز باز می‌شود."/>
        </StackPanel></Grid>
       </Border>
      </StackPanel>
     </ScrollViewer>

     <!-- DNS STUDIO -->
     <ScrollViewer x:Name="DnsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <StackPanel FlowDirection="RightToLeft">
  <Border CornerRadius="24" Padding="27" BorderThickness="1" BorderBrush="#526C9D" Background="{StaticResource HeroGradient}" Margin="0,0,0,18">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="NETWORK LAB  /  DNS STUDIO" Style="{StaticResource EyebrowText}" FontFamily="Segoe UI"/><TextBlock Text="شبکه را دقیق و امن تنظیم کن." FontSize="27" FontWeight="Bold" Margin="0,8,0,7"/><TextBlock Text="پروفایل انتخاب کن، نتیجه را بررسی کن و فقط هنگام اعمال، اجازهٔ ویندوز را تأیید کن." Style="{StaticResource MutedText}" Foreground="#D5DDF0"/></StackPanel>
    <Border Grid.Column="1" Width="84" Height="84" CornerRadius="26" Background="#293E60" BorderBrush="#6585B6" BorderThickness="1" Padding="18" VerticalAlignment="Center"><Path Data="M 32,2 C 32,2 11,26 11,39 A 21,21 0 0 0 53,39 C 53,26 32,2 32,2 Z M 24,40 C 24,46 28,50 33,50" Stroke="#7EF0D9" StrokeThickness="2.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform"/></Border>
   </Grid>
  </Border>
  <Grid FlowDirection="LeftToRight" Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CardBorder}" Grid.Column="0" Margin="0,0,8,0">
    <StackPanel FlowDirection="RightToLeft"><TextBlock Text="کارت شبکهٔ فعال" Style="{StaticResource CardTitle}"/><TextBlock Text="آداپتوری را انتخاب کن که ترافیک بازی از آن عبور می‌کند." Style="{StaticResource MutedText}" Margin="0,0,0,14"/><ComboBox x:Name="NetworkInterfaceCombo" Style="{StaticResource DarkCombo}"/><Border Background="#18243A" BorderBrush="#485D7F" BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,13,0,0"><StackPanel><TextBlock Text="DNS فعلی ویندوز" Foreground="#9AAAC5" FontSize="12"/><TextBlock x:Name="SelectedDnsStatusText" Text="DNS فعلی: —" Foreground="#EDF2FF" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border><Button Style="{StaticResource GhostButton}" Content="تازه‌سازی وضعیت آداپتور" Click="RefreshDnsStatus_Click" Margin="0,13,0,0" HorizontalAlignment="Stretch"/></StackPanel>
   </Border>
   <Border Style="{StaticResource CardBorder}" Grid.Column="1" Margin="8,0,0,0">
    <StackPanel FlowDirection="RightToLeft"><TextBlock Text="آزمایش اتصال" Style="{StaticResource CardTitle}"/><TextBlock Text="پینگ مقصد را اندازه بگیر؛ این عدد با پینگ داخل بازی یکسان نیست." Style="{StaticResource MutedText}" Margin="0,0,0,14"/><TextBlock Text="IP یا hostname مقصد" Foreground="#CFD8EC" FontSize="12" Margin="0,0,0,7"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PingTargetBox" Grid.Column="0" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Text="1.1.1.1" Margin="0,0,8,0"/><Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="شروع Ping" Click="RunPing_Click"/></Grid><Border Background="#142A32" BorderBrush="#337B70" BorderThickness="1" CornerRadius="12" Padding="13" Margin="0,12,0,12"><TextBlock x:Name="PingResultText" Text="آمادهٔ تست شبکه" Foreground="#89F0D9" FontSize="13" TextWrapping="Wrap"/></Border><Button Style="{StaticResource GhostButton}" Content="پاک‌کردن DNS Cache ویندوز" Click="FlushDns_Click" HorizontalAlignment="Stretch"/></StackPanel>
   </Border>
  </Grid>
  <Grid FlowDirection="RightToLeft" Margin="2,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="پروفایل‌های آماده" FontSize="20" FontWeight="Bold"/><TextBlock Text="فقط انتخاب؛ برای اعمال روی ویندوز دکمهٔ اعمال را بزن." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#1A3B3A" BorderBrush="#3F8279" BorderThickness="1" CornerRadius="12" Padding="12,8" VerticalAlignment="Center"><TextBlock Text="۴ پروفایل" Foreground="#8CF4DE" FontWeight="SemiBold"/></Border></Grid>
  <UniformGrid Columns="2" Margin="0,0,0,18">
