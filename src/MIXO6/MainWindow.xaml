        </StackPanel>
       </Border>
       <Grid Margin="0,0,0,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="لابی‌های باز" FontSize="18" FontWeight="Bold"/><TextBlock Text="آدرس سرور برای دیگران پنهان می‌ماند تا Join انجام شود." Style="{StaticResource MutedText}" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" Background="#172D2C" CornerRadius="10" Padding="11,7" VerticalAlignment="Center"><TextBlock Text="PUBLIC MATCHES" Foreground="#80E8D0" FontSize="9" FontFamily="Segoe UI"/></Border></Grid>
       <StackPanel x:Name="LobbiesList"/>
      </StackPanel>
     </ScrollViewer>

     <!-- ACCOUNT -->
