<Window x:Class="MIXO6.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="MIXO6" Width="1440" Height="900" MinWidth="1080" MinHeight="700" WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResize" Background="Transparent" AllowsTransparency="True"
 FlowDirection="LeftToRight" Loaded="Window_Loaded" Closing="Window_Closing">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="20" UseAeroCaptionButtons="False" />
 </shell:WindowChrome.WindowChrome>
 <Border Background="#090C16" BorderBrush="#46516F" BorderThickness="1" CornerRadius="20" ClipToBounds="True">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="264"/></Grid.ColumnDefinitions>

   <!-- Custom title bar -->
   <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#0E1322" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="23,0,0,0">
     <Border Width="35" Height="35" CornerRadius="11" Background="{StaticResource AccentGradient}" Padding="5" Margin="0,0,11,0">
      <Image Source="pack://application:,,,/assets/mixo6-logo.png" Stretch="Uniform"/>
     </Border>
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="MIXO6" FontSize="17" FontWeight="ExtraBold" />
      <TextBlock Text="GAMING CONTROL CENTER" FontSize="8" Foreground="#8490AA" Margin="0,2,0,0" FontFamily="Segoe UI"/>
     </StackPanel>
     <Border Background="#192D34" BorderBrush="#2E615B" BorderThickness="1" CornerRadius="15" Padding="9,5" Margin="15,0,0,0" VerticalAlignment="Center">
      <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#62E7C6" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock Text="WINDOWS · x64" FontSize="9" Foreground="#9EEADB" FontFamily="Segoe UI"/></StackPanel>
     </Border>
    </StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
     <Button Width="37" Height="32" Click="Minimize_Click" Style="{StaticResource TitlebarButton}" ToolTip="کوچک‌کردن پنجره"><Path Data="M 0,0 L 12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
     <Button Width="37" Height="32" Click="Maximize_Click" Style="{StaticResource TitlebarButton}" ToolTip="بزرگ‌نمایی پنجره"><Path Data="M 0,0 H 12 V 12 H 0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
     <Button Width="37" Height="32" Click="Close_Click" Style="{StaticResource TitlebarButton}" Foreground="#F09AAA" ToolTip="بستن برنامه"><Path Data="M 0,0 L 11,11 M 11,0 L 0,11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Button>
    </StackPanel>
   </Grid>

   <!-- Main content -->
   <Grid Grid.Row="1" Grid.Column="0" Background="#0B0F1C">
    <Grid.RowDefinitions><RowDefinition Height="108"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Grid.Row="0" Margin="29,14,27,13" FlowDirection="RightToLeft">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
      <TextBlock x:Name="PageTitleText" Text="مرکز کنترل" FontSize="26" FontWeight="Bold"/>
      <TextBlock x:Name="PageSubtitleText" Text="سخت‌افزار، شبکه و بازی‌ها؛ همه در یک فضای یکپارچه" Foreground="#98A3BC" FontSize="11" Margin="0,5,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
      <Border Background="#141A2A" BorderBrush="#2B354D" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,7,0" MinWidth="91">
       <StackPanel><TextBlock Text="CPU TEMP" FontSize="8" Foreground="#8796B4" FontFamily="Segoe UI"/><TextBlock x:Name="TopCpuTempText" Text="--°C" FontSize="15" FontWeight="Bold" Foreground="#F6BD73" Margin="0,3,0,0"/></StackPanel>
      </Border>
      <Border Background="#141A2A" BorderBrush="#2B354D" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,7,0" MinWidth="91">
       <StackPanel><TextBlock Text="GPU TEMP" FontSize="8" Foreground="#8796B4" FontFamily="Segoe UI"/><TextBlock x:Name="TopGpuTempText" Text="--°C" FontSize="15" FontWeight="Bold" Foreground="#D89BFF" Margin="0,3,0,0"/></StackPanel>
      </Border>
      <Border Background="#141A2A" BorderBrush="#2B354D" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,7,0" MinWidth="84">
       <StackPanel><TextBlock Text="LIVE FPS" FontSize="8" Foreground="#8796B4" FontFamily="Segoe UI"/><TextBlock x:Name="TopFpsText" Text="--" FontSize="15" FontWeight="Bold" Foreground="#70E9D0" Margin="0,3,0,0"/></StackPanel>
      </Border>
      <Border Background="#151B2C" BorderBrush="#303A54" BorderThickness="1" CornerRadius="12" Padding="10,9" VerticalAlignment="Center" Margin="0,0,0,0">
       <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="7" Height="7" Fill="#E4B76B" Margin="0,0,7,0" VerticalAlignment="Center"/><TextBlock x:Name="BackendStatusText" Text="بررسی اتصال" FontSize="10" Foreground="#B9C4DC" VerticalAlignment="Center"/></StackPanel>
      </Border>
     </StackPanel>
    </Grid>

    <Grid Grid.Row="1" Margin="25,0,25,24">
     <!-- DASHBOARD -->
     <ScrollViewer x:Name="DashboardPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel FlowDirection="RightToLeft">
       <Border CornerRadius="22" Padding="25" BorderThickness="1" BorderBrush="#3C5E74" Background="{StaticResource HeroGradient}" Margin="0,0,0,17">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="132" Height="132" CornerRadius="28" Background="#202C49" BorderBrush="#4B577E" BorderThickness="1" Padding="17" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Image Source="pack://application:,,,/assets/mixo6-logo.png" Stretch="Uniform"/>
         </Border>
         <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Text="YOUR SETUP. YOUR RULES." Style="{StaticResource EyebrowText}" FontFamily="Segoe UI"/>
          <TextBlock Text="همه‌چیز زیر کنترل توئه." FontSize="28" FontWeight="Bold" Margin="0,7,0,5"/>
          <TextBlock Text="سخت‌افزار را زنده زیر نظر بگیر، DNS را با تأیید ویندوز مدیریت کن و برای بازی بعدی حریف پیدا کن." Foreground="#C0CBE0" FontSize="12" TextWrapping="Wrap" MaxWidth="650"/>
          <StackPanel Orientation="Horizontal" Margin="0,17,0,0">
           <Button Style="{StaticResource AccentButton}" Click="OpenDnsPage_Click" Content="مدیریت DNS  ›" Margin="0,0,8,0"/>
           <Button Style="{StaticResource GhostButton}" Click="OpenTournamentPage_Click" Content="پیدا کردن حریف" Margin="0,0,8,0"/>
           <Button Style="{StaticResource GhostButton}" Click="ShowWidget_Click" Content="ویجت شناور"/>
          </StackPanel>
         </StackPanel>
        </Grid>
       </Border>

       <Grid Margin="0,0,0,17">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="پردازنده" FontSize="14" FontWeight="Bold"/><TextBlock Text="CPU TEMPERATURE" FontSize="8" Foreground="#8D9AB5" FontFamily="Segoe UI" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="9" Background="#3A3025" Padding="8,5"><TextBlock Text="CPU" Foreground="#F5C481" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI"/></Border></Grid>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,9" VerticalAlignment="Bottom"><TextBlock x:Name="CpuTempText" Text="--°C" FontSize="36" FontWeight="Bold" Foreground="#F5C481"/><TextBlock x:Name="CpuTempCaption" Text="در انتظار سنسور" Foreground="#A6B0C7" FontSize="10" VerticalAlignment="Bottom" Margin="9,0,0,7"/></StackPanel>
          <ProgressBar x:Name="CpuTempBar" Style="{StaticResource AccentProgress}" Maximum="110" Value="0"/>
          <TextBlock x:Name="CpuSensorNameText" Text="سنسور CPU" FontSize="10" Foreground="#7F8CA5" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="کارت گرافیک" FontSize="14" FontWeight="Bold"/><TextBlock Text="GPU TEMPERATURE" FontSize="8" Foreground="#8D9AB5" FontFamily="Segoe UI" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="9" Background="#312641" Padding="8,5"><TextBlock Text="GPU" Foreground="#DBB0FF" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI"/></Border></Grid>
          <StackPanel Orientation="Horizontal" Margin="0,18,0,9" VerticalAlignment="Bottom"><TextBlock x:Name="GpuTempText" Text="--°C" FontSize="36" FontWeight="Bold" Foreground="#D8A6FF"/><TextBlock x:Name="GpuTempCaption" Text="در انتظار سنسور" Foreground="#A6B0C7" FontSize="10" VerticalAlignment="Bottom" Margin="9,0,0,7"/></StackPanel>
          <ProgressBar x:Name="GpuTempBar" Style="{StaticResource AccentProgress}" Maximum="110" Value="0"/>
          <TextBlock x:Name="GpuSensorNameText" Text="سنسور GPU" FontSize="10" Foreground="#7F8CA5" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="7,0,0,0">
         <StackPanel>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="نرخ فریم بازی" FontSize="14" FontWeight="Bold"/><TextBlock Text="LIVE PRESENT FPS" FontSize="8" Foreground="#8D9AB5" FontFamily="Segoe UI" Margin="0,4,0,0"/></StackPanel><Border Grid.Column="1" CornerRadius="9" Background="#1B3637" Padding="8,5"><TextBlock Text="FPS" Foreground="#77E8D2" FontSize="9" FontWeight="Bold" FontFamily="Segoe UI"/></Border></Grid>
          <StackPanel Orientation="Horizontal" Margin="0,17,0,6" VerticalAlignment="Bottom"><TextBlock x:Name="FpsText" Text="--" FontSize="36" FontWeight="Bold" Foreground="#77E8D2"/><TextBlock Text="FPS" FontSize="11" Foreground="#A6B0C7" VerticalAlignment="Bottom" Margin="8,0,0,7" FontFamily="Segoe UI"/></StackPanel>
          <TextBlock Text="برای عدد واقعی، بازی را باز کن و آن را از فهرست انتخاب کن." Style="{StaticResource MutedText}" Margin="0,0,0,11"/>
          <ComboBox x:Name="FpsTargetCombo" Style="{StaticResource DarkCombo}" MinHeight="38" ToolTip="بازی در حال اجرا را انتخاب کن"/>
          <WrapPanel Margin="0,9,0,0"><Button Style="{StaticResource GhostButton}" Content="بازخوانی بازی‌ها" Click="RefreshFpsTargets_Click" Margin="0,0,7,0" Padding="10,7"/><Button Style="{StaticResource AccentButton}" Content="شروع پایش FPS" Click="StartFpsMonitor_Click" Padding="12,7"/><Button Style="{StaticResource GhostButton}" Content="توقف" Click="StopFpsMonitor_Click" Margin="7,0,0,0" Padding="10,7"/></WrapPanel>
          <TextBlock x:Name="FpsStatusText" Text="پایش FPS هنوز فعال نیست." FontSize="10" Foreground="#8D9AB5" Margin="0,9,0,0" TextWrapping="Wrap"/>
          <CheckBox x:Name="FpsRunElevatedCheck" Style="{StaticResource DarkCheck}" Content="در صورت نیاز، درخواست دسترسی مدیر (UAC)" ToolTip="درخواست UAC فقط هنگام شروع پایش و فقط پس از انتخاب این گزینه نمایش داده می‌شود." Margin="0,8,0,0"/>
         </StackPanel>
        </Border>
       </Grid>

       <Grid Margin="0,0,0,17">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardBorder}" Margin="0,0,7,0">
         <StackPanel>
          <TextBlock Text="شبکه‌ی فعال" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="وضعیت واقعی کارت شبکه و DNS فعلی ویندوز" Style="{StaticResource MutedText}" Margin="0,0,0,13"/>
          <TextBlock x:Name="DashboardInterfaceText" Text="کارت شبکه شناسایی نشده" FontSize="13" FontWeight="SemiBold"/>
          <TextBlock x:Name="DashboardDnsText" Text="DNS: —" FontSize="11" Foreground="#B8C4DC" TextWrapping="Wrap" Margin="0,8,0,15"/>
          <StackPanel Orientation="Horizontal"><Button Style="{StaticResource AccentButton}" Content="مدیریت DNS" Click="OpenDnsPage_Click" Margin="0,0,8,0"/><Button Style="{StaticResource GhostButton}" Content="پاک‌کردن کش DNS" Click="FlushDns_Click"/></StackPanel>
         </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,0,0">
         <StackPanel>
          <TextBlock Text="میانبرهای هوشمند" Style="{StaticResource CardTitle}"/>
          <TextBlock Text="کارهای روزمره، بدون جست‌وجو در منوها." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Content="◉   تست Ping و ابزار شبکه" Click="OpenDnsPage_Click" Margin="0,0,0,8"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Content="◈   پیدا کردن حریف" Click="OpenTournamentPage_Click" Margin="0,0,0,8"/>
          <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Content="⬡   سایت‌ها و ابزارهای Origin" Click="OpenSitesPage_Click"/>
         </StackPanel>
        </Border>
       </Grid>
       <Border Background="#111827" BorderBrush="#25344B" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="0,0,0,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#62E7C6" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock x:Name="SensorStatusText" Text="سنسورها در حال راه‌اندازی هستند…" FontSize="10" Foreground="#A6B3CC" VerticalAlignment="Center" TextWrapping="Wrap"/></StackPanel>
         <Button x:Name="ElevateSensorButton" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource GhostButton}" Content="خواندن سنسورها با مجوز مدیر" Click="RestartAsAdmin_Click" Padding="9,6" Margin="12,0,0,0" FontSize="10" ToolTip="فقط پس از تأیید تو، پنجره‌ی UAC ویندوز باز می‌شود."/>
        </Grid>
       </Border>
      </StackPanel>
     </ScrollViewer>

     <!-- DNS STUDIO -->
     <ScrollViewer x:Name="DnsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel FlowDirection="RightToLeft">
       <Border CornerRadius="20" Padding="24" BorderThickness="1" BorderBrush="#3E5D70" Background="{StaticResource HeroGradient}" Margin="0,0,0,17">
        <StackPanel><TextBlock Text="NETWORK LAB  /  DNS STUDIO" Style="{StaticResource EyebrowText}" FontFamily="Segoe UI"/><TextBlock Text="شبکه را به سلیقه‌ی خودت تنظیم کن." FontSize="25" FontWeight="Bold" Margin="0,7,0,6"/><TextBlock Text="پروفایل‌ها ابتدا انتخاب می‌شوند؛ تغییر واقعی فقط بعد از زدن دکمه و تأیید دسترسی ویندوز انجام می‌شود." Style="{StaticResource MutedText}" Foreground="#C3CDE1"/></StackPanel>
       </Border>
       <Border Style="{StaticResource CardBorder}" Margin="0,0,0,17">
        <StackPanel>
         <TextBlock Text="کارت شبکه و وضعیت جاری" Style="{StaticResource CardTitle}"/>
         <TextBlock Text="کارت شبکه‌ای را انتخاب کن که اینترنت بازی از آن عبور می‌کند." Style="{StaticResource MutedText}" Margin="0,0,0,13"/>
         <ComboBox x:Name="NetworkInterfaceCombo" Style="{StaticResource DarkCombo}" MinHeight="42"/>
         <Border Background="#101727" BorderBrush="#2E3B54" BorderThickness="1" CornerRadius="10" Padding="13" Margin="0,12,0,0">
          <TextBlock x:Name="SelectedDnsStatusText" Text="DNS فعلی: —" Foreground="#B6C4DC" FontSize="11" TextWrapping="Wrap"/>
         </Border>
        </StackPanel>
       </Border>
       <TextBlock Text="پروفایل‌های آماده" FontSize="17" FontWeight="Bold" Margin="2,0,0,11"/>
       <UniformGrid Columns="2" Margin="0,0,0,17">
        <Border Style="{StaticResource CardBorder}" Margin="0,0,7,7"><StackPanel><Border Background="#27314B" Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Left" Padding="9"><TextBlock Text="CS" Foreground="#AFC4FF" FontWeight="Bold" FontSize="16" FontFamily="Segoe UI" HorizontalAlignment="Center"/></Border><TextBlock Text="CS2 · Google DNS" FontSize="14" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="8.8.8.8  /  8.8.4.4" FontSize="12" Foreground="#F6C27F" FontFamily="Consolas"/><TextBlock Text="برای ترجمه‌ی نام دامنه‌ها؛ پینگ داخل بازی تضمین نمی‌شود." Style="{StaticResource MutedText}" Margin="0,9,0,12"/><Button Style="{StaticResource GhostButton}" Content="انتخاب پروفایل" Click="UseCs2Dns_Click" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Style="{StaticResource CardBorder}" Margin="7,0,0,7"><StackPanel><Border Background="#302545" Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Left" Padding="9"><TextBlock Text="MC" Foreground="#D9B4FF" FontWeight="Bold" FontSize="15" FontFamily="Segoe UI" HorizontalAlignment="Center"/></Border><TextBlock Text="Minecraft · Origin" FontSize="14" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="78.157.42.101  /  78.157.42.100" FontSize="12" Foreground="#D9B4FF" FontFamily="Consolas"/><TextBlock Text="پروفایل پیشنهادی؛ نتیجه به مسیر ISP بستگی دارد." Style="{StaticResource MutedText}" Margin="0,9,0,12"/><Button Style="{StaticResource GhostButton}" Content="انتخاب پروفایل" Click="UseMinecraftDns_Click" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Style="{StaticResource CardBorder}" Margin="0,7,7,0"><StackPanel><Border Background="#3A2E24" Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Left" Padding="9"><TextBlock Text="OC" Foreground="#FFD49A" FontWeight="Bold" FontSize="15" FontFamily="Segoe UI" HorizontalAlignment="Center"/></Border><TextBlock Text="ORIGIN · Custom A" FontSize="14" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="194.146.68.68  /  194.146.68.66" FontSize="12" Foreground="#FFD49A" FontFamily="Consolas"/><TextBlock Text="آدرس‌های DNS اختصاصی ثبت‌شده برای MIXO6." Style="{StaticResource MutedText}" Margin="0,9,0,12"/><Button Style="{StaticResource GhostButton}" Content="انتخاب پروفایل" Click="UseOriginDns_Click" HorizontalAlignment="Left"/></StackPanel></Border>
        <Border Style="{StaticResource CardBorder}" Margin="7,7,0,0"><StackPanel><Border Background="#203B37" Width="44" Height="44" CornerRadius="13" HorizontalAlignment="Left" Padding="9"><TextBlock Text="OB" Foreground="#81EAD1" FontWeight="Bold" FontSize="15" FontFamily="Segoe UI" HorizontalAlignment="Center"/></Border><TextBlock Text="ORIGIN · Custom B" FontSize="14" FontWeight="Bold" Margin="0,12,0,4"/><TextBlock Text="78.157.42.100  /  78.157.42.10" FontSize="12" Foreground="#81EAD1" FontFamily="Consolas"/><TextBlock Text="گزینه‌ی دوم از فهرست DNSهای خودت." Style="{StaticResource MutedText}" Margin="0,9,0,12"/><Button Style="{StaticResource GhostButton}" Content="انتخاب پروفایل" Click="UseOriginDnsB_Click" HorizontalAlignment="Left"/></StackPanel></Border>
       </UniformGrid>
       <Border Style="{StaticResource CardBorder}" Margin="0,0,0,17">
        <StackPanel>
         <TextBlock Text="تنظیمات DNS دستی" Style="{StaticResource CardTitle}"/>
         <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,7,0"><TextBlock Text="DNS اصلی · IPv4 یا IPv6" FontSize="11" Foreground="#A8B4CC" Margin="0,0,0,7"/><TextBox x:Name="PrimaryDnsBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Text="194.146.68.68"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="7,0,0,0"><TextBlock Text="DNS جایگزین" FontSize="11" Foreground="#A8B4CC" Margin="0,0,0,7"/><TextBox x:Name="SecondaryDnsBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Text="194.146.68.66"/></StackPanel>
         </Grid>
         <WrapPanel Margin="0,15,0,0"><Button Style="{StaticResource AccentButton}" Content="اعمال DNS روی ویندوز" Click="ApplyDns_Click" Margin="0,0,8,0"/><Button Style="{StaticResource GhostButton}" Content="بازگردانی DNS خودکار" Click="ResetDns_Click" Margin="0,0,8,0"/><Button Style="{StaticResource GhostButton}" Content="تازه‌سازی وضعیت" Click="RefreshDnsStatus_Click"/></WrapPanel>
         <Border Background="#101727" CornerRadius="10" Padding="12" Margin="0,13,0,0"><TextBlock x:Name="DnsActionStatusText" Text="آماده؛ هنوز تغییری انجام نشده است." Foreground="#A9B6CE" FontSize="11" TextWrapping="Wrap"/></Border>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource CardBorder}">
        <StackPanel>
         <TextBlock Text="ابزارهای تشخیص شبکه" Style="{StaticResource CardTitle}"/>
         <TextBlock Text="پینگ مقصد را بررسی می‌کند؛ این مقدار معادل پینگ داخل بازی نیست." Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="PingTargetBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Text="1.1.1.1" Margin="0,0,8,0"/><Button Grid.Column="1" Style="{StaticResource AccentButton}" Content="شروع Ping" Click="RunPing_Click"/></Grid>
         <TextBlock x:Name="PingResultText" Text="آماده برای تست" Foreground="#82E8D2" FontSize="12" Margin="0,12,0,15"/>
         <Button Style="{StaticResource GhostButton}" Content="پاک‌کردن DNS Cache ویندوز" Click="FlushDns_Click" HorizontalAlignment="Left"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>

     <!-- TOURNAMENT / LOBBIES -->
     <ScrollViewer x:Name="TournamentPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel FlowDirection="RightToLeft">
       <Border CornerRadius="20" Padding="24" BorderBrush="#3F5973" BorderThickness="1" Background="{StaticResource HeroGradient}" Margin="0,0,0,17">
        <StackPanel><TextBlock Text="MATCHMAKING  /  PLAY TOGETHER" Style="{StaticResource EyebrowText}" FontFamily="Segoe UI"/><TextBlock Text="حریف بعدی، همین‌جاست." FontSize="26" FontWeight="Bold" Margin="0,7,0,5"/><TextBlock Text="لابی بساز، بازی و سرور را مشخص کن؛ آدرس سرور تا قبل از پیوستن به عضو بعدی نشان داده نمی‌شود." Style="{StaticResource MutedText}" Foreground="#C2CDE0"/></StackPanel>
       </Border>
       <Border Style="{StaticResource CardBorder}" Margin="0,0,0,17">
        <StackPanel>
         <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ساخت لابی جدید" Style="{StaticResource CardTitle}"/><TextBlock Text="برای ساخت لابی باید وارد حساب تأییدشده شده باشی." Style="{StaticResource MutedText}"/></StackPanel><Border Grid.Column="1" Background="#1A3137" BorderBrush="#305F60" BorderThickness="1" CornerRadius="10" Padding="10,7"><TextBlock Text="حداکثر ۲ بازیکن" Foreground="#8CE8D6" FontSize="10"/></Border></Grid>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,7,11"><TextBlock Text="نام بازی" FontSize="11" Foreground="#A8B4CC" Margin="0,0,0,6"/><TextBox x:Name="LobbyGameBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Text="CS2"/></StackPanel>
          <StackPanel Grid.Column="1" Margin="7,0,0,11"><TextBlock Text="ریجن / برچسب سرور" FontSize="11" Foreground="#A8B4CC" Margin="0,0,0,6"/><TextBox x:Name="LobbyServerLabelBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Text="EU / Iran / Custom"/></StackPanel>
         </Grid>
         <TextBlock Text="آدرس سرور بازی (IP:PORT یا لینک)" FontSize="11" Foreground="#A8B4CC" Margin="0,0,0,6"/><TextBox x:Name="LobbyServerAddressBox" FlowDirection="LeftToRight" Style="{StaticResource InputBox}" Margin="0,0,0,11"/>
         <TextBlock Text="توضیحات، مود یا قوانین" FontSize="11" Foreground="#A8B4CC" Margin="0,0,0,6"/><TextBox x:Name="LobbyDescriptionBox" FlowDirection="RightToLeft" Style="{StaticResource InputBox}" MinHeight="76" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,14" VerticalContentAlignment="Top"/>
         <WrapPanel><Button Style="{StaticResource AccentButton}" Content="ساخت لابی" Click="CreateLobby_Click" Margin="0,0,8,0"/><Button Style="{StaticResource GhostButton}" Content="تازه‌سازی فهرست" Click="RefreshLobbies_Click"/></WrapPanel>
         <Border Background="#101727" BorderBrush="#2E3A53" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0"><TextBlock x:Name="LobbyStatusText" Text="برای نمایش لابی‌های آنلاین، وضعیت اتصال را بررسی کن." Foreground="#B5C1D8" FontSize="11" TextWrapping="Wrap"/></Border>
         <Border x:Name="JoinedLobbyResultBorder" Visibility="Collapsed" Background="#18322F" BorderBrush="#36786E" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,12,0,0">
          <StackPanel><TextBlock Text="آدرس سرور لابی متصل‌شده" Foreground="#9CECDD" FontWeight="Bold"/><TextBlock x:Name="JoinedLobbyAddressText" Text="" Foreground="#F4F7FF" FontSize="13" Margin="0,7,0,10" TextWrapping="Wrap"/><Button Style="{StaticResource GhostButton}" Content="کپی آدرس سرور" Click="CopyJoinedAddress_Click" HorizontalAlignment="Left"/></StackPanel>
