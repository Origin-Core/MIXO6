      <StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="MIXO6" FontSize="22" FontWeight="ExtraBold"/><TextBlock Text="PLAY DIFFERENT" FontSize="8" Foreground="#8794B0" Margin="0,4,0,0" FontFamily="Segoe UI"/></StackPanel>
