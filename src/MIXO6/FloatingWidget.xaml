<Window x:Class="MIXO6.FloatingWidget"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MIXO6 Monitor" Width="378" Height="112" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded">
 <Border CornerRadius="22" BorderBrush="#775D6A91" BorderThickness="1" Padding="13" MouseLeftButtonDown="Root_MouseLeftButtonDown">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F2131929" Offset="0"/><GradientStop Color="#F31D2037" Offset="0.55"/><GradientStop Color="#F20E2B32" Offset="1"/></LinearGradientBrush></Border.Background>
  <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.48"/></Border.Effect>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Width="42" Height="48" CornerRadius="14" Background="#25384A" BorderBrush="#506B7E" BorderThickness="1" Padding="7" VerticalAlignment="Center">
    <Image Source="pack://application:,,,/assets/mixo6-logo.png" Stretch="Uniform"/>
   </Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,6,0">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,7">
     <Border Background="#342D26" BorderBrush="#6A5538" BorderThickness="1" CornerRadius="9" Padding="8,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><TextBlock Text="CPU" FontSize="9" FontWeight="Bold" Foreground="#E9D1AF" Margin="0,0,6,0"/><TextBlock x:Name="CpuTempText" Text="--°C" FontSize="15" FontWeight="Bold" Foreground="#FFCA76"/></StackPanel></Border>
     <Border Background="#2D263E" BorderBrush="#5E4D7B" BorderThickness="1" CornerRadius="9" Padding="8,5" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><TextBlock Text="GPU" FontSize="9" FontWeight="Bold" Foreground="#D9C4FF" Margin="0,0,6,0"/><TextBlock x:Name="GpuTempText" Text="--°C" FontSize="15" FontWeight="Bold" Foreground="#E4B0FF"/></StackPanel></Border>
     <Border Background="#1F3A3A" BorderBrush="#3D7771" BorderThickness="1" CornerRadius="9" Padding="8,5"><StackPanel Orientation="Horizontal"><TextBlock Text="FPS" FontSize="9" FontWeight="Bold" Foreground="#A2ECDD" Margin="0,0,6,0"/><TextBlock x:Name="FpsText" Text="--" FontSize="15" FontWeight="Bold" Foreground="#73F0D6"/></StackPanel></Border>
    </StackPanel>
    <StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="#66E7C9" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="MIXO6  ·  REAL-TIME MONITOR" FontSize="8" Foreground="#98A8C5" FontFamily="Segoe UI"/></StackPanel>
   </StackPanel>
   <Button Grid.Column="2" Content="×" Click="Hide_Click" Background="Transparent" BorderThickness="0" Foreground="#B5BED1" FontSize="18" Padding="0" VerticalAlignment="Top" Cursor="Hand" ToolTip="مخفی‌کردن ویجت"/>
  </Grid>
 </Border>
</Window>
