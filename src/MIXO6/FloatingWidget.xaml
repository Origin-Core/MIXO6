<Window x:Class="MIXO6.FloatingWidget"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MIXO6 Monitor" Width="455" Height="144" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded" FontFamily="Segoe UI">
 <Border CornerRadius="24" BorderBrush="#6E91A9D8" BorderThickness="1" Padding="15" MouseLeftButtonDown="Root_MouseLeftButtonDown">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F2182036" Offset="0"/><GradientStop Color="#F51C2945" Offset="0.52"/><GradientStop Color="#F2153A3A" Offset="1"/></LinearGradientBrush></Border.Background>
  <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.55"/></Border.Effect>
  <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions>
   <Border Grid.RowSpan="2" Grid.ColumnSpan="3" Background="#193A7DFF" CornerRadius="18" IsHitTestVisible="False" Margin="0,0,0,0" Opacity="0.16"/>
   <Border Grid.RowSpan="2" Grid.Column="0" Width="46" Height="54" CornerRadius="15" Background="#273B59" BorderBrush="#5C789A" BorderThickness="1" Padding="8" VerticalAlignment="Center"><Image Source="pack://application:,,,/assets/mixo6-logo.png" Stretch="Uniform"/></Border>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,0,10">
     <Border Background="#383228" BorderBrush="#7C6240" BorderThickness="1" CornerRadius="11" Padding="10,6" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="#F6D3A4" Margin="0,0,8,0"/><TextBlock x:Name="CpuTempText" Text="--°C" FontSize="17" FontWeight="Bold" Foreground="#FFC675"/></StackPanel></Border>
     <Border Background="#342B4B" BorderBrush="#66578E" BorderThickness="1" CornerRadius="11" Padding="10,6" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><TextBlock Text="GPU" FontSize="11" FontWeight="Bold" Foreground="#E5D5FF" Margin="0,0,8,0"/><TextBlock x:Name="GpuTempText" Text="--°C" FontSize="17" FontWeight="Bold" Foreground="#EAB7FF"/></StackPanel></Border>
     <Border Background="#1D3F41" BorderBrush="#4A8883" BorderThickness="1" CornerRadius="11" Padding="10,6"><StackPanel Orientation="Horizontal"><TextBlock Text="FPS" FontSize="11" FontWeight="Bold" Foreground="#A8F2E4" Margin="0,0,8,0"/><TextBlock x:Name="FpsText" Text="--" FontSize="17" FontWeight="Bold" Foreground="#75F0D9"/></StackPanel></Border>
    </StackPanel>
    <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#79F1D8" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock Text="MIXO6  ·  پایش زندهٔ سیستم" FontSize="11" Foreground="#B3C0D9"/></StackPanel>
   </StackPanel>
   <Button Grid.Column="2" Grid.Row="0" Content="×" Click="Hide_Click" Background="Transparent" BorderThickness="0" Foreground="#C9D1E3" FontSize="21" Padding="0" VerticalAlignment="Top" Cursor="Hand" ToolTip="مخفی‌کردن ویجت"/>
  </Grid>
 </Border>
</Window>
