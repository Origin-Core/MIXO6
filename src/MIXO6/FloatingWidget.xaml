<Window x:Class="MIXO6.FloatingWidget"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="MIXO6 Monitor" Width="278" Height="78" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" Loaded="Window_Loaded">
 <Border CornerRadius="16" Background="#E811111B" BorderBrush="#554A465F" BorderThickness="1" Padding="11" MouseLeftButtonDown="Root_MouseLeftButtonDown">
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
   <Image Grid.Column="0" Source="assets/mixo6-logo.png" Width="29" Height="39" Stretch="Uniform" VerticalAlignment="Center"/>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,4,0">
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
     <TextBlock Text="CPU" FontSize="9" FontWeight="Bold" Foreground="#C5C1D4" Margin="0,0,5,0"/><TextBlock x:Name="CpuTempText" Text="--°C" FontSize="15" FontWeight="Bold" Foreground="#FFB85C" Margin="0,0,14,0"/>
     <TextBlock Text="GPU" FontSize="9" FontWeight="Bold" Foreground="#C5C1D4" Margin="0,0,5,0"/><TextBlock x:Name="GpuTempText" Text="--°C" FontSize="15" FontWeight="Bold" Foreground="#EE55D8"/>
    </StackPanel>
    <TextBlock Text="MIXO6 · HARDWARE MONITOR" FontSize="8" Foreground="#8F8CA3" Margin="0,4,0,0"/>
   </StackPanel>
   <Button Grid.Column="2" Content="×" Click="Hide_Click" Background="Transparent" BorderThickness="0" Foreground="#A8A4B6" FontSize="16" Padding="0" VerticalAlignment="Top" Cursor="Hand"/>
  </Grid>
 </Border>
</Window>
